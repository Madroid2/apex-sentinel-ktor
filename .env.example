SENTINEL_ENV=development
SENTINEL_STORAGE=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/sentinel
DATABASE_USER=sentinel
DATABASE_PASSWORD=replace-for-non-local-use
SENTINEL_API_KEYS=apex:replace-with-a-long-random-key
SENTINEL_ADMIN_KEY=replace-with-a-separate-long-random-admin-key
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2
PORT=8080
